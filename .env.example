# ==============================================================================
# LinkVault Environment Configuration Template
# ==============================================================================
# ZERO CONFIGURATION NEEDED FOR LOCAL DEVELOPMENT!
# If you run `npm start` with no .env file, LinkVault automatically defaults to:
# - SQLite (linkvault.db in WAL mode)
# - Local filesystem disk storage (/uploads)
#
# To enable PostgreSQL and Cloudflare R2 (as claimed on resume):
# Fill in the variables below:
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Managed PostgreSQL Database (Neon Serverless, Render Postgres, Supabase)
# ------------------------------------------------------------------------------
# Leave blank to use local embedded SQLite (zero setup)
# Example: postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. S3-Compatible Object Storage (Cloudflare R2, Supabase Storage, or MinIO)
# ------------------------------------------------------------------------------
# Leave blank to store temporary files on local disk in /uploads (zero setup)

# --- Configuration Choice 1: Cloudflare R2 ($0 Egress - Production Default) ---
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens:
# R2_ACCOUNT_ID=55b03bafa5e00fcd8ea4112233445566
# R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key
# R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
# R2_BUCKET_NAME=linkvault-files
# R2_REGION=auto
# R2_FORCE_PATH_STYLE=false

# --- Configuration Choice 2: Supabase Storage S3 (No Credit Card Testing) ---
# Obtain from Supabase Project Settings -> Storage -> S3 Access Keys:
# R2_ENDPOINT=https://<your-project-ref>.storage.supabase.co/storage/v1/s3
# R2_ACCESS_KEY_ID=your_supabase_s3_access_key
# R2_SECRET_ACCESS_KEY=your_supabase_s3_secret_key
# R2_BUCKET_NAME=linkvault-files
# R2_REGION=eu-west-2
# R2_FORCE_PATH_STYLE=true

# --- Configuration Choice 3: MinIO Local Emulator (Docker) ---
# R2_ENDPOINT=http://localhost:9000
# R2_ACCESS_KEY_ID=minioadmin
# R2_SECRET_ACCESS_KEY=minioadmin
# R2_BUCKET_NAME=linkvault-files
# R2_REGION=us-east-1
# R2_FORCE_PATH_STYLE=true
